  "dialogue_sequences": [
    {
      "id": "dialogue.c2_03.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Our leads from Mulu point to the waterways of Batang Ai."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Recon Drones are crossing above the river route. Ground blockers can't stop them."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Give ranged Rangers clear coverage and leave the ground line in place for the rest."
        }
      ]
    },
    {
      "id": "dialogue.c2_03.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The next wave is already close. We have less time to reset between groups."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Check both the path and the air coverage before you commit another deployment."
        }
      ]
    },
    {
      "id": "dialogue.c2_03.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The crossing is secure. The Canopy Defense Launcher is ready. Kenyalang Seer joins the roster and is preparing for field duty."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Have them review the drone data. The next group may use more interference."
        }
      ]
    },
    {
      "id": "dialogue.c2_03.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We lost the crossing under pressure from the air and ground waves."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Separate those two coverage problems on the plan. We'll try again with a clearer line."
        }
      ]
    }
  ],
