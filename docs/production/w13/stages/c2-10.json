  "dialogue_sequences": [
    {
      "id": "dialogue.c2_10.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "This is the last interception. The Poacher Leader has fast reinforcements and can surge forward in the final phase."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the tunnel approach covered. We'll deal with each wave and bring the Leader in."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.wave_4",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 4},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The last support wave is moving. It includes a Wildlife Trafficker."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Stop that target. Keep enough coverage for the Poacher Leader behind it."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.boss_intro",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "boss_intro", "boss_id": "boss.poacher_leader"},
      "lines": [
        {
          "speaker_id": "speaker.poacher_leader",
          "pose_key": "confronting",
          "text": "You followed every trail this far. Can you hold the last one?"
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "The routes from Mulu to Sepilok all lead here. Team, stay with the exit approach."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.boss_phase_1",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "boss_phase_changed", "boss_id": "boss.poacher_leader", "phase_index": 1},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Poacher Leader called for Contraband Runners. Track the entry."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the Leader covered while the patrol deals with the Runners."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.boss_phase_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "boss_phase_changed", "boss_id": "boss.poacher_leader", "phase_index": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Leader is breaking forward. Another Runner is on the way."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Hold the last turn. Keep watching until the reinforcements have cleared."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The reinforcements are accounted for. The Poacher Leader is in custody."
        },
        {
          "speaker_id": "speaker.poacher_leader",
          "pose_key": "captured",
          "text": "You stopped this route. That doesn't make the forest easy to guard."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "It gives the patrol and the forest some breathing room. Good work, team."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We've lost the line. The patrol is falling back."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "We'll review where the last waves reached the tunnel and try again."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.defeat_trafficker",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "defeat", "cause": "fatal_escape", "enemy_id": "E15"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Wildlife Trafficker got through. We have to end the attempt."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Set a clearer priority on the next plan. We still need to finish the interception."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.defeat_leader",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "defeat", "cause": "fatal_escape", "enemy_id": "boss.poacher_leader"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Poacher Leader reached the tunnel. The interception failed."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Withdraw the patrol. We'll reset and keep someone on the final approach."
        }
      ]
    },
    {
      "id": "dialogue.c2_10.epilogue",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "after_victory_dialogue", "first_clear_only": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The teams are back at HQ. I'll send the patrol reports to Records."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Add a note on the trees we protected. Rhinoceros Hornbills use tree cavities for their nests."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "I'll include that in the field notes. We can keep the routes under watch and return to the restoration work."
        }
      ],
      "fact_refs": ["fact.hornbill_tree_cavity"]
    }
  ],
