  "dialogue_sequences": [
    {
      "id": "dialogue.c2_05.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The trail reaches Tanjung Datu. We have a route through coastal forest."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Tracking Bots are slowing our attacks, and Ranger deployments cost more here."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Check the Token cost before you drop. Intercept the Bots before they can stall the line."
        }
      ]
    },
    {
      "id": "dialogue.c2_05.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The next group is bringing more automation."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Watch anyone whose attacks have slowed. Keep a second Ranger covering their approach."
        }
      ]
    },
    {
      "id": "dialogue.c2_05.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The pursuit on this stretch is contained. The Disruption Beacon is ready. Saboteurist joins the roster and is preparing for field duty."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Get the next coastal position ready. We'll need that support against the capture teams."
        }
      ]
    },
    {
      "id": "dialogue.c2_05.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We couldn't keep the route covered through the interference."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Let's review the opening cost and where the attack slow reached our Rangers."
        }
      ]
    }
  ],
