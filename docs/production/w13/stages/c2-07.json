  "dialogue_sequences": [
    {
      "id": "dialogue.c2_07.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Our lead goes into Imbak Canyon. Keep an eye on the gorge route and the Heat gauge."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "An Ignition Operator can drive Heat to the limit. Each time that happens, we lose Integrity."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "We have a Firebreak Beacon for this operation. Budget its normal cost and intercept the Heat sources. The Beacon only slows the buildup."
        }
      ]
    },
    {
      "id": "dialogue.c2_07.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The next group includes more Ignition Operators."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep watching the gauge even if your blockers are healthy. Heat takes its toll on Integrity."
        }
      ]
    },
    {
      "id": "dialogue.c2_07.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The gorge route is clear. I have the Heat readings for the next team."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Then let's find the person directing the logging crews."
        }
      ]
    },
    {
      "id": "dialogue.c2_07.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We couldn't hold the gorge. Get the team clear."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Check the gauge history and where the Ignition Operators reached your line. We'll make an earlier interception."
        }
      ]
    }
  ],
