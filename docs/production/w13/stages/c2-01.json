  "dialogue_sequences": [
    {
      "id": "dialogue.c2_01.opening",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The trail from the chokepoint leads into Gunung Mulu. The limestone ridges and forest cover give us fewer clear sightlines."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "We have movement at both entrances. Mist and smoke are making the fast groups hard to follow."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Cover A and B. Use the moments when concealed targets come back into view, and keep the shared exit covered."
        }
      ]
    },
    {
      "id": "dialogue.c2_01.wave_2",
      "status": "proposed_review_pending",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Both tracks meet before the tunnel. Keep the merge in view while the next groups approach."
        },
        {
          "speaker_id": "speaker.poacher",
          "pose_key": "alert",
          "text": "They're watching the lower approach. Keep moving until we can meet at the bend."
        }
      ]
    },
    {
      "id": "dialogue.c2_01.victory",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The first Mulu route is secure. The K9 Ranger is available for the next operation."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Check the route notes before we move. There may be heavier equipment on the ridge."
        }
      ]
    },
    {
      "id": "dialogue.c2_01.defeat",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We lost control of the approaches in the mist."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Look at the coverage on each lane. We'll take the next attempt from the plan."
        }
      ]
    }
  ],
