  "dialogue_sequences": [
    {
      "id": "dialogue.c1_05.opening",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The diverted force is at the old route. We have a fixed stockpile of 120 Tokens and no Logistics Posts."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Plan the whole line before you spend. We need the Diversion Captain in custody."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "A stronger escort is coming through. The Captain is still behind it."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep enough coverage for the last wave. We can't rely on new supplies."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.boss_intro",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "boss_intro", "boss_id": "boss.diversion_captain"},
      "lines": [
        {
          "speaker_id": "speaker.diversion_captain",
          "pose_key": "confronting",
          "text": "You moved your patrol for one trail. How many others are you watching?"
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "That's the Captain. Nearby enemies are moving faster under the Captain's orders."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Stay with the approach. Stop the Captain before the tunnel."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.boss_phase_1",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "boss_phase_changed", "boss_id": "boss.diversion_captain", "phase_index": 1},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Captain called for more Poachers. Watch the entrance."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Hold the Captain and keep a Ranger covering the arriving group."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.victory",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The Diversion Captain is in custody. Barricade Ops can reinforce us."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Well done. Bring the patrol home and have the team check the Captain's trail."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.defeat",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The diversion broke our hold on the route."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "We still have a chance to intercept the Captain. Recheck the stockpile and the approach."
        }
      ]
    },
    {
      "id": "dialogue.c1_05.defeat_captain",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "defeat", "cause": "fatal_escape", "enemy_id": "boss.diversion_captain"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Captain reached the tunnel. We missed the capture."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Pull the patrol back. We'll reset the line and close that route on the next attempt."
        }
      ]
    }
  ],
