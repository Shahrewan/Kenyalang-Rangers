    {
      "id": "dialogue.c2_04.opening",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Signal Jammers are interfering with active skills. The groups are coming in closer together as well."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep coverage from basic attacks. Use ready skills when the affected Rangers can act."
        }
      ]
    },
    {
      "id": "dialogue.c2_04.wave_2",
      "status": "proposed_review_pending",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "We have another interference signal. Watch the skill warnings."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the slow or delayed activation from opening a gap. Change position when it's safe."
        }
      ]
    },
    {
      "id": "dialogue.c2_04.victory",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "Comms are clearing. Crowd Controller and the Electric Pulse Turret are available."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Log the interference pattern. The next lead takes us toward Tanjung Datu."
        }
      ]
    },
    {
      "id": "dialogue.c2_04.defeat",
      "status": "proposed_review_pending",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The tight arrivals and skill delays overwhelmed the line."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Build coverage that can hold between activations. Then we'll take another pass."
        }
      ]
    }
  ],
