  "dialogue_sequences": [
    {
      "id": "dialogue.c1_03.opening",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Some of them are running ahead of the pack. Watch the outer turn."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "If a Ranger is in trouble, hold to reveal Retreat. Watch the deployment card for the cooldown. On a later run, you can try a skill once it is unlocked and ready."
        }
      ]
    },
    {
      "id": "dialogue.c1_03.messenger",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "wave_resolved", "wave": 2, "presentation_event_id": "cinematic.c1_03_messenger_withdrawal"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Movement beyond our line. There's a messenger taking the far trail."
        },
        {
          "speaker_id": "speaker.poacher_messenger",
          "pose_key": "alert",
          "text": "Captain, the old route is guarded. The patrol stayed."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Log the sighting. Keep your attention on the enemies still in the operation."
        }
      ]
    },
    {
      "id": "dialogue.c1_03.victory",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "Our line held. The Guard Veteran and Medic Cabin crew can join us."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "The messenger will have reached someone by now. Let's get ready for a larger push."
        }
      ]
    },
    {
      "id": "dialogue.c1_03.defeat",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "Pull back. The route is too exposed to hold."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "We'll work out which positions to reinforce and which Rangers to pull out earlier."
        }
      ]
    }
  ],
