  "dialogue_sequences": [
    {
      "id": "dialogue.c2_09.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The trails converge through Sepilok-Kabili. The convoy is making for the final corridor."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Expect Portable Mortar Crews, Heavy Breachers and a Wildlife Trafficker. If the Trafficker reaches the tunnel, we lose the operation."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Watch the mortar warnings and leave coverage for the Trafficker. We need that target stopped."
        }
      ]
    },
    {
      "id": "dialogue.c2_09.wave_3",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 3},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The Wildlife Trafficker is in this wave. Confirm your coverage at the turn."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep a Ranger watching the exit approach. We can't let that target through."
        }
      ]
    },
    {
      "id": "dialogue.c2_09.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The convoy has been intercepted. The Wildlife Traffickers on this route were stopped."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "One operation left. Review what worked here before we face the Poacher Leader."
        }
      ]
    },
    {
      "id": "dialogue.c2_09.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We've lost the convoy line. Fall back to the plan."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Review the Siege warnings and where the heavy units reached the blockers."
        }
      ]
    },
    {
      "id": "dialogue.c2_09.defeat_trafficker",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "defeat", "cause": "fatal_escape", "enemy_id": "E15"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Wildlife Trafficker reached the tunnel. The operation has failed."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Get the team clear. We'll give that target priority on the next attempt."
        }
      ]
    }
  ],
