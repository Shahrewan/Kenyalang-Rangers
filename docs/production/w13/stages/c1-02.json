  "dialogue_sequences": [
    {
      "id": "dialogue.c1_02.opening",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The new reports agree. They planned to use this route. These aren't stray trespassers."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Put a blocker on the ground route and give them support from above. Keep an eye on Integrity."
        }
      ]
    },
    {
      "id": "dialogue.c1_02.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The next group is moving faster."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Fill any gap in the line before it reaches your blocker."
        }
      ]
    },
    {
      "id": "dialogue.c1_02.victory",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The chokepoint is holding. Our medic and a Sonic Turret team are available now."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Bring them up. Someone is coordinating those groups."
        }
      ]
    },
    {
      "id": "dialogue.c1_02.defeat",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The line broke. I'm pulling the patrol back."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Check where the pressure reached the ground line. We can cover that spot on the next attempt."
        }
      ]
    }
  ],
