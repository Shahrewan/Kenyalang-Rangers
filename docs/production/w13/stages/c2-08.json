  "dialogue_sequences": [
    {
      "id": "dialogue.c2_08.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The Illegal Logging Foreman is leading this push. The equipment raises Heat and can add a temporary layer of protection."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep pressure on the sources of Heat. Plan for a longer hold if the Foreman gains protection."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.wave_3",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 3},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "We have movement behind the last logging crews. The Foreman is close."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Confirm what you can keep in the field for the final wave."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.boss_intro",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "boss_intro", "boss_id": "boss.illegal_logging_foreman"},
      "lines": [
        {
          "speaker_id": "speaker.illegal_logging_foreman",
          "pose_key": "confronting",
          "text": "How long do you think your patrol can hold this gorge?"
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Long enough to stop this operation. Keep your attention on the route, team."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.boss_phase_1",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "boss_phase_changed", "boss_id": "boss.illegal_logging_foreman", "phase_index": 1},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The Foreman's temporary protection is up and Heat is rising faster."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the route covered. Use the protection and Heat indicators to plan your next attack."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The Foreman is stopped. We're closing the canyon operation."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Record the equipment and the route. Follow the remaining leads into Sepilok-Kabili."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.victory_foreman_escaped",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "victory", "boss_id": "boss.illegal_logging_foreman", "boss_resolution": "escaped"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "Our line held, but the Foreman reached the tunnel."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Report the escape. We'll follow the remaining evidence into Sepilok-Kabili."
        }
      ]
    },
    {
      "id": "dialogue.c2_08.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We lost the canyon line. The team is withdrawing."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Review the Foreman's approach and the Heat pressure. We'll regroup before trying again."
        }
      ]
    }
  ],
