  "dialogue_sequences": [
    {
      "id": "dialogue.c1_01.opening",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Leader? I left a patrol at the old chokepoint. I was about to recall them when they spotted poachers on the trail."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "You did the right thing calling. Keep the patrol on comms. We can support them from here."
        },
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "The Starter Post is ready. I'll mark the pair of raised tiles."
        }
      ]
    },
    {
      "id": "dialogue.c1_01.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Second group on the same trail."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the approach covered. Leave the patrol a clear view of the path."
        }
      ]
    },
    {
      "id": "dialogue.c1_01.victory",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The first push is over. I have the patrol accounted for."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Good. Leave a watch at the chokepoint while we find out why they came this way."
        }
      ]
    },
    {
      "id": "dialogue.c1_01.defeat",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_chapter_1",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "We can't hold this position. I'm calling the patrol back."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Get them clear. We'll review the approach and try again."
        }
      ]
    }
  ],
