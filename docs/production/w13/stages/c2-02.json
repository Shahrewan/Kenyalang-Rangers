    {
      "id": "dialogue.c2_02.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Demolitionists are approaching the ridge. They can damage a Facility while it's still being built."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Watch the build timers and intercept Siege crews before they reach the sites."
        }
      ]
    },
    {
      "id": "dialogue.c2_02.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Another demolition crew is on the route. Check the marked approach."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Keep the elevated sites supported while the ground team intercepts them."
        }
      ]
    },
    {
      "id": "dialogue.c2_02.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The ridge is secure. The Outpost Mechanic and Ranger Coordination Hub are available."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Send the route record to HQ. It may show where the next supply group is heading."
        }
      ]
    },
    {
      "id": "dialogue.c2_02.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "The ridge defense broke under the Siege push."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Review where the crews got close to construction. We can change the placement before the retry."
        }
      ]
    }
  ],
