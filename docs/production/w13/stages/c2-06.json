  "dialogue_sequences": [
    {
      "id": "dialogue.c2_06.opening",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "operation_opening"},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Net Trappers are moving up the coastal trail. Their gear can interrupt a Ranger at the front."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Put support within reach. Leave yourself a way to move someone out if the line starts giving way."
        }
      ]
    },
    {
      "id": "dialogue.c2_06.wave_2",
      "status": "approved_c26_placeholder",
      "origin": "new_proposed_binding_and_copy",
      "trigger": {"event": "before_wave_first_spawn", "wave": 2},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "briefing",
          "text": "Watch the net windup. A Ranger can be tied up before their next attack."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "steady",
          "text": "Cover that lane with another attacker. Retreat is still there if you need it."
        }
      ]
    },
    {
      "id": "dialogue.c2_06.victory",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "victory", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "relieved",
          "text": "The coastal extraction route is closed. Dispatch Relay is ready. Strike Team joins the roster and is preparing for field duty."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Pass their route logs to HQ. Our next lead takes us into Imbak Canyon."
        }
      ]
    },
    {
      "id": "dialogue.c2_06.defeat",
      "status": "approved_c26_placeholder",
      "origin": "proposed_adaptation_of_team_draft",
      "trigger": {"event": "defeat", "fallback": true},
      "lines": [
        {
          "speaker_id": "speaker.operations_manager",
          "pose_key": "concerned",
          "text": "Too many Rangers lost their attack windows. The line is broken."
        },
        {
          "speaker_id": "speaker.leader",
          "pose_key": "reassuring",
          "text": "Give the front a second source of coverage and check the status warnings on the retry."
        }
      ]
    }
  ],
