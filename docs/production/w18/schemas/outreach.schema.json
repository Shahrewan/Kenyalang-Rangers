{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W18 outreach review data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schema_version",
    "content_revision",
    "editorial_status",
    "locale",
    "refresh_hours",
    "max_questions_per_batch",
    "shuffle_choices",
    "payout_status",
    "questions"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/outreach.schema.json"
    },
    "kind": {
      "const": "outreach"
    },
    "schema_version": {
      "const": 1
    },
    "content_revision": {
      "type": "integer",
      "minimum": 1
    },
    "editorial_status": {
      "const": "draft_source_checked"
    },
    "locale": {
      "const": "en-MY"
    },
    "refresh_hours": {
      "const": 20
    },
    "max_questions_per_batch": {
      "const": 5
    },
    "shuffle_choices": {
      "const": true
    },
    "payout_status": {
      "const": "provisional"
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "prompt",
          "source_ids",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^outreach\\.[a-z][a-z0-9_]*$"
          },
          "topic": {
            "enum": [
              "community_needs",
              "donor_transparency",
              "misinformation",
              "nest_privacy",
              "responsible_tourism",
              "trail_access",
              "wildlife_rescue"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^source\\.[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "choices": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "grade",
                "justification"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^outreach\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "grade": {
                  "enum": [
                    "best",
                    "acceptable",
                    "poor",
                    "harmful"
                  ]
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "maxItems": 4,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "grade": {
                      "const": "best"
                    }
                  },
                  "required": [
                    "grade"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "grade": {
                      "const": "acceptable"
                    }
                  },
                  "required": [
                    "grade"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "grade": {
                      "const": "poor"
                    }
                  },
                  "required": [
                    "grade"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "grade": {
                      "const": "harmful"
                    }
                  },
                  "required": [
                    "grade"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      },
      "maxItems": 20
    }
  }
}
