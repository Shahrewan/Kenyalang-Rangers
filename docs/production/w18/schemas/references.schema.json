{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W18 references review data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schema_version",
    "content_revision",
    "editorial_status",
    "locale",
    "checked_on",
    "reuse",
    "sources",
    "facts",
    "garden_fact_candidates"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/references.schema.json"
    },
    "kind": {
      "const": "references"
    },
    "schema_version": {
      "const": 1
    },
    "content_revision": {
      "type": "integer",
      "minimum": 1
    },
    "editorial_status": {
      "const": "draft_source_checked"
    },
    "locale": {
      "const": "en-MY"
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    },
    "reuse": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^source\\.[a-z][a-z0-9_]*$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fact\\.[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^source\\.[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "garden_fact_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species.strangler_fig",
        "species.belian",
        "species.red_meranti",
        "species.mengaris",
        "restoration_event.nest_box"
      ],
      "properties": {
        "species.strangler_fig": {
          "type": "string",
          "pattern": "^fact\\.[a-z][a-z0-9_]*$"
        },
        "species.belian": {
          "type": "string",
          "pattern": "^fact\\.[a-z][a-z0-9_]*$"
        },
        "species.red_meranti": {
          "type": "string",
          "pattern": "^fact\\.[a-z][a-z0-9_]*$"
        },
        "species.mengaris": {
          "type": "string",
          "pattern": "^fact\\.[a-z][a-z0-9_]*$"
        },
        "restoration_event.nest_box": {
          "type": "string",
          "pattern": "^fact\\.[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
