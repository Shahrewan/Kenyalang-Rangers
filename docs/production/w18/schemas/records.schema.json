{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W18 records review data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schema_version",
    "content_revision",
    "editorial_status",
    "locale",
    "question_timer_seconds",
    "payout_status",
    "final_first_correct_funds",
    "gdd_budget_model",
    "chapters"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/records.schema.json"
    },
    "kind": {
      "const": "records"
    },
    "schema_version": {
      "const": 1
    },
    "content_revision": {
      "type": "integer",
      "minimum": 1
    },
    "editorial_status": {
      "const": "draft_source_checked"
    },
    "locale": {
      "const": "en-MY"
    },
    "question_timer_seconds": {
      "const": 15
    },
    "payout_status": {
      "const": "provisional"
    },
    "final_first_correct_funds": {
      "type": "null"
    },
    "gdd_budget_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approx_questions",
        "first_correct_funds_each",
        "perfect_chapter_bonus_count",
        "perfect_chapter_bonuses_funds_total"
      ],
      "properties": {
        "approx_questions": {
          "const": 40
        },
        "first_correct_funds_each": {
          "const": 30000
        },
        "perfect_chapter_bonus_count": {
          "const": 4
        },
        "perfect_chapter_bonuses_funds_total": {
          "const": 350000
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "records_room_level",
          "topic",
          "ranger_id",
          "perfect_clear_enhancement",
          "final_perfect_chapter_funds",
          "questions"
        ],
        "properties": {
          "id": {
            "enum": [
              "records_chapter.scout_sniper",
              "records_chapter.patrolman",
              "records_chapter.combat_medic",
              "records_chapter.woods_tracker"
            ]
          },
          "records_room_level": {
            "type": "integer",
            "minimum": 2,
            "maximum": 5
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "ranger_id": {
            "enum": [
              "ranger.scout_sniper",
              "ranger.patrolman",
              "ranger.combat_medic",
              "ranger.woods_tracker"
            ]
          },
          "perfect_clear_enhancement": {
            "type": "string",
            "minLength": 1
          },
          "final_perfect_chapter_funds": {
            "type": "null"
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "prompt",
                "correct_choice_id",
                "choices",
                "explanation",
                "source_ids",
                "fact_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^records\\.[a-z][a-z0-9_]*$"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "correct_choice_id": {
                  "type": "string",
                  "pattern": "^records\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                },
                "choices": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "text"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^records\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "maxItems": 4
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^source\\.[a-z][a-z0-9_]*$"
                  },
                  "uniqueItems": true
                },
                "fact_ids": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "pattern": "^fact\\.[a-z][a-z0-9_]*$"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      },
      "maxItems": 4
    }
  }
}
